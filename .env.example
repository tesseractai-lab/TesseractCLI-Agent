# =============================================
# .env > for main environment 
# .env.prod > for production changes
# .env.dev > for development changes
# ===========================================
# .env.example


# ====== Application Settings ======
ENV_MODE="dev"          # dev | prod
APP_NAME="TesseractCLI"
APP_VERSION="1.0.0"

# ====== Logging (shared paths/policy) ======
DEBUG=True
LOG_DIR=logs
LOG_ROTATION="10 MB"
LOG_RETENTION="15 days"

# ====== Tools ======
MAX_LINES_WITHOUT_RANGE=2000
DEFAULT_TIMEOUT_SECONDS=30
MAX_OUTPUT_CHARS=10000

# ===== Cloud provider API keys ====
CEREBRAS_API_KEY=""
GROQ_API_KEY=""
MISTRAL_API_KEY=""
HUGGINGFACE_API_KEY=""
ANTHROPIC_API_KEY=""
TOGETHER_API_KEY=""
OPENAI_API_KEY=""
# --- Local GGUF provider ---
LOCAL_GGUF_MODEL_PATH=""